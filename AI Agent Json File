      "parameters": {
        "jsCode": "// Flatten each competitor's article list into individual items, cap 5 most recent per competitor, dedupe by URL across the whole run.\nconst seen = new Set();\nconst out = [];\n\nfor (const item of items) {\n  const competitor = item.json.query ? item.json.query : (item.json?.competitor || 'Unknown');\n  const articles = (item.json.articles || []).slice(0, 5);\n  for (const a of articles) {\n    if (!a.url || seen.has(a.url)) continue;\n    seen.add(a.url);\n    out.push({\n      json: {\n        competitor,\n        title: a.title,\n        description: a.description || '',\n        url: a.url,\n        source: a.source?.name || 'Unknown',\n        publishedAt: a.publishedAt\n      }\n    });\n  }\n}\nreturn out;"
