    {
      "parameters": {
        "jsCode": "// Aggregate all filtered articles into ONE digest item: group by competitor, build Slack Block Kit + HTML email body.\nconst byCompetitor = {};\nfor (const item of items) {\n  const c = item.json.competitor;\n  byCompetitor[c] = byCompetitor[c] || [];\n  byCompetitor[c].push(item.json);\n}\n\nconst today = new Date().toISOString().slice(0, 10);\nlet slackBlocks = [\n  { type: 'header', text: { type: 'plain_text', text: '🗞️ Competitor Digest — ' + today } }\n];\nlet html = '<h2>Competitor News Digest — ' + today + '</h2>';\n\nconst competitors = Object.keys(byCompetitor);\nif (competitors.length === 0) {\n  slackBlocks.push({ type: 'section', text: { type: 'mrkdwn', text: 'No relevant competitor news today.' } });\n  html += '<p>No relevant competitor news today.</p>';\n} else {\n  for (const c of competitors) {\n    slackBlocks.push({ type: 'divider' });\n    slackBlocks.push({ type: 'section', text: { type: 'mrkdwn', text: '*' + c + '*' } });\n    html += '<h3>' + c + '</h3><ul>';\n    for (const a of byCompetitor[c]) {\n      slackBlocks.push({\n        type: 'section',\n        text: { type: 'mrkdwn', text: '• *[' + a.category + ']* <' + a.url + '|' + a.title + '>\\n' + a.summary }\n      });\n      html += '<li><b>[' + a.category + ']</b> <a href=\"' + a.url + '\">' + a.title + '</a><br>' + a.summary + '</li>';\n    }\n    html += '</ul>';\n  }\n}\n\nreturn [{ json: { slackBlocks, htmlBody: html, date: today, articleCount: items.length } }];"
      },
