      "parameters": {
        "jsCode": "// Parse the AI's JSON reply and re-attach the original article fields (the HTTP node\n// replaces item JSON with only the API response, so we pull originals by index).\nconst originals = $('Extract & Flatten Articles').all();\nconst out = [];\nfor (let idx = 0; idx < items.length; idx++) {\n  const item = items[idx];\n  const original = (originals[idx] && originals[idx].json) ? originals[idx].json : {};\n  let parsed = { summary: original.description || 'No summary available.', category: 'Other', relevance_score: 5 };\n  try {\n    const raw = item.json.choices?.[0]?.message?.content || '{}';\n    const cleaned = raw.trim().replace(/^```json/, '').replace(/^```/, '').replace(/```$/, '');\n    parsed = JSON.parse(cleaned);\n  } catch (e) {\n    // keep fallback\n  }\n  out.push({\n    json: {\n      competitor: original.competitor,\n      title: original.title,\n      description: original.description,\n      url: original.url,\n      source: original.source,\n      publishedAt: original.publishedAt,\n      summary: parsed.summary,\n      category: parsed.category,\n      relevance_score: Number(parsed.relevance_score) || 5\n    }\n  });\n}\nreturn out;"
      },
